# Environment example for Interview Simulator
# Copy to .env and fill in actual values, or export variables in your shell
#
# ⚠️  IMPORTANT: .env should NEVER be committed to git.
# Add it to .gitignore if it's not already.
#
# Get your GROQ_API_KEY from: https://console.groq.com/keys

GROQ_API_KEY=your_new_groq_api_key_here
PORT=3000
