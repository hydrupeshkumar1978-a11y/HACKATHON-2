{
  "name": "interview-simulator",
  "version": "1.0.0",
  "description": "A browser-based interview simulator with AI-driven Q&A, resume uploads, and transcript export.",
  "repository": {
    "type": "git",
    "url": "https://code.swecha.org/hydrupeshkumar/hackathon-2.git"
  },
  "keywords": [
    "interview",
    "simulator",
    "AI",
    "resume",
    "chatbot",
    "Bun",
    "Groq"
  ],
  "author": "Hyd Rupesh Kumar",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "prepare": "husky install",
    "dev": "bun run src/server.ts",
    "start": "bun run src/server.ts",
    "lint": "eslint . --ext .ts,.js",
    "lint:fix": "eslint . --ext .ts,.js --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "biome": "biome check .",
    "oxlint": "oxlint .",
    "knip": "knip",
    "audit": "bun audit",
    "audit:fix": "bun audit --fix",
    "secret-scan": "sh -c 'if command -v gitleaks >/dev/null 2>&1; then gitleaks protect --staged --source .; else echo \"gitleaks not installed; skipping secret scan\"; fi'",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "quality": "bun run lint && bun run format && bun run biome && bun run oxlint && bun run knip && bun run typecheck && bun run audit",
    "changelog": "git-cliff --output CHANGELOG.md",
    "changelog:preview": "git-cliff --unreleased"
  },
  "dependencies": {
    "groq-sdk": "^0.8.0",
    "pdf-parse": "^1.1.1",
    "mammoth": "^1.4.18"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@types/bun": "latest",
    "@types/node": "latest",
    "@types/pdf-parse": "latest",
    "@typescript-eslint/eslint-plugin": "^6.4.0",
    "@vitest/coverage-v8": "^4.1.8",
    "biome": "npm:@biomejs/biome@^2.4.16",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-config-standard-with-typescript": "^43.0.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-n": "^15.7.0",
    "eslint-plugin-promise": "^6.1.1",
    "eslint-plugin-unused-imports": "^3.1.0",
    "gitleaks": "^1.0.0",
    "happy-dom": "^20.10.2",
    "husky": "^8.0.3",
    "knip": "^6.16.1",
    "lint-staged": "^14.0.0",
    "oxlint": "^1.69.0",
    "prettier": "^3.0.0",
    "typescript": "5.3.3",
    "vitest": "^4.1.8"
  },
  "lint-staged": {
    "*.{js,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
